# Copiar a .env y completar con los valores del proyecto de Supabase
# (Project Settings → Database → Connection string).

# Conexión pooled (Supavisor, puerto 6543) — la usa la app en runtime.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa (puerto 5432) — la usa Prisma solo para migraciones.
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Origen permitido por CORS (URL del frontend).
FRONTEND_ORIGIN="http://localhost:5173"

# Puerto local (no aplica en Vercel).
PORT=3001
