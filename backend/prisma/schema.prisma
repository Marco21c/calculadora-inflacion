generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model IpcEntry {
  anio                        Int
  mes                         Int
  ipc                         Float
  inflacionMensual            Float  @map("inflacion_mensual")
  inflacionInteranual         Float? @map("inflacion_interanual")
  promedioAnualIpc            Float? @map("promedio_anual_ipc")
  variacionInteranualPromedio Float? @map("variacion_interanual_promedio")

  @@id([anio, mes])
  @@map("ipc_entries")
}
