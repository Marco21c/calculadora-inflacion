# Copiar a .env (en la raíz del repo) para levantar todo con docker compose.

POSTGRES_USER=inflacion
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=inflacion

# Origen permitido por CORS. Con nginx sirviendo frontend y backend en el
# mismo dominio esto casi no se usa, pero conviene dejarlo apuntando al
# dominio/IP público real del VPS.
FRONTEND_ORIGIN=http://localhost

# Puerto del host donde nginx publica el sitio (80 por defecto).
HTTP_PORT=80
