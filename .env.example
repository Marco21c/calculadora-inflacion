# Copiar a .env (en la raíz del repo) para levantar el frontend público con
# docker compose. El backend y la DB viven en Vercel/Supabase, no acá.

# URL pública del backend deployado en Vercel, sin barra final.
BACKEND_URL=https://tu-backend.vercel.app

# Puerto del host donde nginx publica el sitio (80 por defecto).
HTTP_PORT=80
